# Copy to .env and fill in. `.env` is gitignored — keep it that way.

# Connection string for the demo cluster (Database Access user with readWrite).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"

# Database the demo writes to. Everything this repo creates lives here.
MONGODB_DATABASE=mongo_analytics

# Atlas Administration API key (Organization/Project level) — used to provision
# the Stream Processing workspace and the Database Triggers programmatically.
# Create under: Atlas > Access Manager > API Keys.
MONGODB_ATLAS_PUBLIC_API_KEY=<public-key>
MONGODB_ATLAS_PRIVATE_API_KEY=<private-key>
MONGODB_ATLAS_PROJECT_ID=<project-id>

# Optional: the Stream Processing workspace hostname (printed by
# 06_setup_stream_workspace.sh). Lets 10_reset_demo.sh skip the API lookup —
# useful when the API key's IP access list blocks your current IP.
#ASP_HOSTNAME=<workspace-hostname>
